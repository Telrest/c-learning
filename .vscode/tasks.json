{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C: build debug",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-O0",
        "-g3",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "C: build release",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "-finput-charset=UTF-8",
        "-fexec-charset=UTF-8",
        "-O2",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
