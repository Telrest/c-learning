{
  "files.encoding": "utf8",
  "terminal.integrated.profiles.windows": {
    "PowerShell UTF-8": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoExit",
        "-Command",
        "[Console]::InputEncoding = [System.Text.UTF8Encoding]::new(); [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new(); $OutputEncoding = [Console]::OutputEncoding"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell UTF-8",
  "files.autoSave": "afterDelay",
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": false,
  "editor.suggest.preview": false,
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.clang_format_style": "{ BasedOnStyle: LLVM, IndentWidth: 4, BreakBeforeBraces: Allman }",
  "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
  "terminal.integrated.env.windows": {
    "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
  }
}
